{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "cyj-hashtag-site",
  "main": "cloudflare-worker.mjs",
  "account_id": "622694f2427aa9f94c5098dc8bba25ef",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/session", "/socket", "/partition-quiz/server-config.json"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
